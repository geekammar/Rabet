# Rabet — environment variables
# ---------------------------------------------------------------------------
# This file documents variables that LATER PHASES will require.
#
# None of these are read by the application in Phase 1.
#
# To use them later:  cp .env.example .env.local   and fill in real values.
# Never commit real secrets — .env* files are git-ignored (.env.example is the
# only exception, and it must always contain placeholders).

# Public app URL — used for absolute links, OAuth redirects and webhook
# registration. Must match the deployed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string on Neon — Phase 03 (database schema & migrations)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Auth.js session secret — Phase 02 (admin authentication)
# Generate one with:  npx auth secret   (or openssl rand -base64 32)
# AUTH_SECRET=replace-with-a-generated-secret

# Telegram bot token issued by @BotFather — Phase 06 (Telegram bot onboarding)
# TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram Stars payments — Phase 08 (payment integration)
# Digital goods sold inside Telegram are settled through the Telegram Bot API;
# no payment provider token is required for digital goods.
