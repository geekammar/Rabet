# Version control and CI definitions
.git
.gitignore
.github

# Local and environment files — never admit env files or secrets to build context
.env
.env*
*.env
secrets
.secrets
*.pem
*.key
*.crt
*.p12
*.pfx

# Dependencies, build artifacts, and caches
node_modules
.pnp
.pnp.*
.yarn
.next
out
build
dist
coverage
.cache
.npm
.turbo
.vercel
.render
*.tsbuildinfo
next-env.d.ts

# Logs, audit artifacts, and execution reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
audit-*.json
audit-*.log
audit-summary.txt
REPORT.md

# Non-runtime repository directories (migrations, tests, docs, local scripts)
docs
drizzle
drizzle.config.ts
scripts
tests
vitest.config.ts
eslint.config.mjs
README.md
AGENTS.md
